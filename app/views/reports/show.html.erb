<h1><%= t('views.common.title_show', name: Report.model_name.human) %></h1>

<div class="show-item">
  <%= render @report %>
</div>

<%= render 'application/comments', commentable: @report %>

<nav class="page-nav">
  <% if @report.editable?(current_user) %>
    <%= link_to t('views.common.edit', name: Report.model_name.human.downcase), edit_report_path(@report) %> |
  <% end %>
  <%= link_to t('views.common.back', name: i18n_pluralize(Report.model_name.human.downcase)), reports_path %>

  <% if @report.editable?(current_user) %>
    <%= button_to t('views.common.destroy', name: Report.model_name.human.downcase), @report, method: :delete %>
  <% end %>
</nav>

<hr>
<h3>この日報が言及している日報</h3>
<% if @report.mentioned_reports.any? %>
  <ul>
    <% @report.mentioned_reports.each do |r| %>
      <li>
        <%= link_to "#{r.id} #{r.title}", report_path(r) %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>この日報が言及している日報はありません。</p>
<% end %>

<h3>この日報が言及されている日報</h3>
<% if @report.mentioning_reports.any? %>
  <ul>
    <% @report.mentioning_reports.each do |r| %>
      <li>
        <%= link_to "#{r.id} #{r.title}", report_path(r) %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>この日報が言及されている日報はありません。</p>
<% end %>
