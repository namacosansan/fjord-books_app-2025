<%= form_with(model: [commentable, form_comment]) do |form| %>
  <% if form.object.errors.any? %>
    <div style="color: red">
      <ul>
        <% form.object.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :body %>
    <%= form.text_area :body, required: true %>
  </div>

  <div>
    <%= form.submit t('comments.submit') %>
  </div>
<% end %>
