<div>
  <h2><%= t('comments.title') %></h2>

  <% if comments.any? %>
    <% comments.each do |each_comment| %>
      <%= render 'comments/comment', comment: each_comment %>
    <% end %>
  <% else %>
    <p><%= t('comments.empty') %></p>
  <% end %>

  <h3><%= t('comments.new') %></h3>
  <%= render "comments/form", comment: commentable.comments.new %>
</div>
