<div class="comment">
  <p><%= comment.body %></p>
  <% if comment.user == current_user %>
  <%= link_to t('comments.delete'),
              [comment.commentable, comment],
              data: { turbo_method: :delete, turbo_confirm: t('comments.delete_confirm')} %>
  <% end %>
  <% if comment.user.name.present? %>
    <%= comment.user.name %>
  <% else %>
    <%= comment.user.email %>
  <% end %>
  <p><%= comment.created_at&.strftime("%Y/%m/%d %H:%M") %></p>
</div>
 