<p style="color: green"><%= notice %></p>

<% content_for :title, t("books.index.title") %>

<h1><%= t("books.index.title") %></h1>

<div id="books" class="index-items">
  <% @books.each do |book| %>
    <div class="index-item">
      <%= render book %>
      <p>
        <%= link_to t("books.index.show"), book %>
      </p>
    </div>
  <% end %>
</div>

<p>
  <nav class="page-nav">
    <%= link_to t("books.index.new"), new_book_path %>
  </nav>
</p>

<ul>
  <li><%= link_to t("locale_switch.to_japanese"), books_path(locale: :ja) %></li>
  <li><%= link_to t("locale_switch.to_english"),  books_path(locale: :en) %></li>
</ul>

<p>現在のロケール: <%= I18n.locale %></p>
