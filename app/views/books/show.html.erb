<h1><%= t('views.common.title_show', name: Book.model_name.human) %></h1>

<div class="show-item">
  <%= render 'books/book', book: @book %>
</div>

<nav class="page-nav">
  <%= link_to t('views.common.edit', name: Book.model_name.human), edit_book_path(@book) %> |
  <%= link_to t('views.common.back', name: Book.model_name.human), books_path %>
  <%= button_to t('views.common.destroy', name: Book.model_name.human), @book, method: :delete %>
</nav>

<%= render 'comments/comments',
           commentable: @book,
           comments: @book.comments.order(created_at: :desc) %>
